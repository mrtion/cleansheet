{
  // CleanSheet — Cloudflare Workers 部署配置（单 Worker 全托管）
  // 构建：nuxi build（Nitro cloudflare_module preset）
  //   → .output/server/index.mjs（Worker）+ .output/public（静态资产）
  // 部署：wrangler deploy
  "name": "cleansheet",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".output/public" },
  "kv_namespaces": [
    { "binding": "KV", "id": "70ec4f7ee7f9478393620e76d7197a0f" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cleansheet",
      "database_id": "a50d9204-8fdf-4184-a9b9-ec66b75613e3",
      "migrations_dir": "server/db/migrations"
    }
  ],
  "routes": [
    { "pattern": "cleansheet.mrtion.kdns.fr/*", "zone_name": "mrtion.kdns.fr" }
  ],
  "vars": {
    "NUXT_PUBLIC_APP_URL": "https://cleansheet.mrtion.kdns.fr"
    // 管理后台：用 `wrangler secret put ADMIN_EMAILS` 设置管理员邮箱（逗号分隔），
    // secret 立即生效、无需重新部署，且不会进代码库。未设置则无人是管理员。
  }
  // 存储架构（2026-10-07 Phase 2b 起）：
  // - D1（binding DB）：关系型账本 —— users / subscriptions / templates /
  //   usage_records / usage_dedup。迁移见 server/db/migrations/（TDD 6.1 表结构，
  //   templates 仅多出 platform_name 一列以承载前端 platformName，见迁移注释）。
  // - KV（binding KV）：仅短暂数据 —— 会话 sess:{token}（30 天 TTL）、
  //   登录限频 rl:login:{ip}（60s TTL）。
  // - 配额原子性：/api/quota/consume 使用 D1 条件更新
  //   `... and conversions < 20` 的单语句原子语义保证不超扣，
  //   因此 TDD D9 的 Durable Objects QuotaLimiter 不再需要，推迟/取消。
  // 后续添加：ratelimits / triggers.crons(["0 3 1 * *"]) 汇率月更。
}
